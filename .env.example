# ============================================================================
# RAG Platform local environment template
# ============================================================================
# Copy this file to .env before starting the local stack:
#   cp .env.example .env
# This template contains local defaults/placeholders only. Never commit a
# populated .env file or production credentials.
#
# MVP scope: M0 provides the application skeleton, M1 adds tenant/knowledge-
# base RBAC, M2 adds digital-document Evidence ingestion, M3 adds authorized RAG,
# M4 adds enterprise governance, M5 adds manifest connectors, and M6 adds LLM
# Wiki projection. Scanned PDFs/OCR and Knowledge Graph projections remain later
# milestones.

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
# Runtime profile and application log verbosity.
APP_ENV=development
# Deployment profile: dev | eval | on-prem | saas. A profile only supplies
# defaults for variables that are not set explicitly; env values always win.
CONFIG_PROFILE=dev
APP_LOG_LEVEL=debug
# Address listened to inside the API container.
API_ADDR=0.0.0.0:8080
# Host port exposed by Compose. Change if this port is already occupied.
API_PORT=8082
# Browser-facing service URLs. Keep API_PUBLIC_URL aligned with API_PORT; it is
# passed to the web container as VITE_API_BASE_URL. WEB_PUBLIC_URL is not read
# yet: the development CORS origin is fixed in the HTTP router.
API_PUBLIC_URL=http://localhost:8082
WEB_PUBLIC_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# PostgreSQL / pgvector
# ----------------------------------------------------------------------------
# Local database name, user and password used by the Compose service.
POSTGRES_DB=rag_platform
POSTGRES_USER=rag_platform
POSTGRES_PASSWORD=change-me-local-only
# Service port for tools running outside Docker. Containers use the postgres
# hostname in DATABASE_URL. The app itself reads only DATABASE_URL.
POSTGRES_PORT=5432
# Full connection string consumed by the API and database migration commands.
# This is the single source of truth for database connectivity.
# Production rejects the shipped change-me-local-only password in DATABASE_URL,
# MAINTENANCE_DATABASE_URL and ADMIN_DATABASE_URL.
DATABASE_URL=postgres://rag_platform:change-me-local-only@postgres:5432/rag_platform?sslmode=disable
# Tenant row-level security. shadow (default) installs the policies and audits
# writes; enforce additionally requires the split roles below and is a
# deployment decision (see docs/operations.md).
TENANT_RLS_MODE=shadow
# Enforce-mode role split. DATABASE_URL must then use rag_app (NOBYPASSRLS);
# MAINTENANCE_DATABASE_URL carries the BYPASSRLS role for the API's pre-tenant
# lookups and every worker job; ADMIN_DATABASE_URL is the table owner used by
# migrate, seed and embedctl. Passwords are set by `make m13-rls-setup`.
# RAG_APP_DB_PASSWORD=change-me-app
# RAG_MAINTENANCE_DB_PASSWORD=change-me-maintenance
# MAINTENANCE_DATABASE_URL=postgres://rag_maintenance:change-me-maintenance@postgres:5432/rag_platform?sslmode=disable
# ADMIN_DATABASE_URL=postgres://rag_platform:change-me-local-only@postgres:5432/rag_platform?sslmode=disable
# Per-process connection pool. Keep replicas × DATABASE_MAX_OPEN_CONNS below
# PostgreSQL max_connections. Lifetime recycles connections after failover;
# 0 disables recycling and should not be used in production.
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_SECONDS=1800
# Optional overrides for `make migrate` and `make seed`. Both default to the
# directories baked into the image, so they only need setting when the SQL or
# seed files are mounted from somewhere else.
MIGRATIONS_DIR=
SEEDS_DIR=

# ----------------------------------------------------------------------------
# Redis / Asynq task queues
# ----------------------------------------------------------------------------
# Redis address inside the Compose network.
REDIS_ADDR=redis:6379
# Optional Redis password, used by the API's task publisher and the worker's
# queue server. Leave empty for a local Redis without auth.
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# S3-compatible object storage (local MinIO)
# ----------------------------------------------------------------------------
# MinIO root credentials are for local development only. Production should use
# scoped credentials or workload identity instead.
MINIO_ROOT_USER=rag-local
MINIO_ROOT_PASSWORD=change-me-local-only
# Container-to-container endpoint and bucket configuration.
S3_ENDPOINT=minio:9000
S3_REGION=us-east-1
S3_BUCKET=rag-platform-local
# Application credentials used by API and Worker to access the bucket.
# Production rejects the shipped rag-local / change-me-local-only values.
S3_ACCESS_KEY=rag-local
S3_SECRET_KEY=change-me-local-only
# Local MinIO uses HTTP and path-style addressing.
S3_USE_TLS=false
# Force path-style addressing (http://endpoint/bucket/key). S3-compatible
# endpoints such as MinIO cannot be reached as bucket.host, so keep this true
# for them; false leaves the storage client's own endpoint detection in charge.
S3_FORCE_PATH_STYLE=true

# ----------------------------------------------------------------------------
# Authentication and development identity
# ----------------------------------------------------------------------------
# Replace with a unique random secret of at least 32 bytes before shared use.
# Production requires this fallback to be replaced by an explicit
# JWT_SIGNING_KEYS entry; startup fails otherwise.
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes
# Optional key-rotation ring, "kid:secret,kid:secret". When set it replaces
# JWT_SIGNING_KEY; JWT_ACTIVE_KID selects the key that signs new sessions while
# the other kids keep verifying tokens issued before the rotation.
# Production requires this to be set explicitly.
JWT_SIGNING_KEYS=
JWT_ACTIVE_KID=
JWT_ISSUER=rag-platform
JWT_AUDIENCE=rag-platform-api
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_NAME=rag_session
# Must be true in production (HTTPS-only session cookie).
AUTH_COOKIE_SECURE=false
# Development identity headers (X-Dev-User-ID / X-Dev-Tenant-ID). Never enable
# outside development or test.
DEV_AUTH_ENABLED=true
# Pepper mixed into API-key hashes; changing it invalidates every issued key.
# Production rejects the shipped placeholder.
API_KEY_PEPPER=replace-with-a-random-api-key-pepper
# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For and
# X-Real-IP headers may be trusted for audit, rate-limit and quota attribution.
# Empty trusts no proxy, so the audit IP is the direct TCP peer. List only the
# ingress network; 0.0.0.0/0 and ::/0 are rejected at startup.
HTTP_TRUSTED_PROXIES=

# OIDC authorization-code flow with PKCE. Production requires OIDC or LDAP;
# set OIDC_ENABLED=true and point the issuer at the provider discovery document.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8082/api/v1/auth/callback
OIDC_SCOPES=openid,email,profile
OIDC_TENANT_CLAIM=tenant_id
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
# Keep closed registration in shared environments: only memberships that
# already exist are linked, unless auto-provision is explicitly enabled.
OIDC_AUTO_PROVISION=false
OIDC_DEFAULT_TENANT=

# LDAP/AD directory login. When enabled, users bind with their directory
# password (never stored) and the role comes from LDAP_GROUP_ROLE_MAP.
# LDAP_USER_FILTER and LDAP_GROUP_FILTER must contain %s. Production requires
# ldaps:// or LDAP_START_TLS=true unless LDAP_ALLOW_INSECURE acknowledges plain
# LDAP for a trusted loopback network.
LDAP_ENABLED=false
LDAP_URL=ldap://localhost:389
LDAP_START_TLS=false
LDAP_TLS_SKIP_VERIFY=false
LDAP_ALLOW_INSECURE=false
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid=%s)
LDAP_USER_ID_ATTRIBUTE=uid
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_NAME_ATTRIBUTE=cn
LDAP_GROUP_ATTRIBUTE=memberOf
LDAP_GROUP_FILTER=
LDAP_TENANT_ID=
LDAP_AUTO_PROVISION=true
# Empty means users without a mapped group are rejected.
LDAP_DEFAULT_ROLE=
# Semicolon-separated group DN or CN to tenant role, e.g. cn=rag-admins=admin;cn=rag-viewers=viewer
LDAP_GROUP_ROLE_MAP=
LDAP_SYNC_USER_FILTER=(objectClass=person)
LDAP_SYNC_INTERVAL_SECONDS=3600
LDAP_TIMEOUT_SECONDS=10

# Local Keycloak development fixture. The realm, client and test user are in
# deploy/keycloak/rag-realm.json with development-only credentials. Start it
# with `docker compose --profile oidc --env-file .env -f deploy/docker-compose/docker-compose.yml up -d keycloak`,
# then set OIDC_ENABLED=true, OIDC_ISSUER=<KEYCLOAK_HOSTNAME>/realms/rag and
# OIDC_CLIENT_ID/SECRET from that file. KEYCLOAK_HOSTNAME must be reachable
# from both the browser and the api container; localhost is host-only.
KEYCLOAK_HOSTNAME=http://localhost:8083
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only

# ----------------------------------------------------------------------------
# Governance and operational limits
# ----------------------------------------------------------------------------
# Requests per tenant per minute in one API process. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=600
# Durable tenant quotas. 0 disables the quota.
TENANT_MAX_DOCUMENTS=0
TENANT_MAX_STORAGE_MB=0
TENANT_CHAT_REQUESTS_PER_DAY=0
# Model resolutions per tenant per capability per minute. 0 disables the limit.
TENANT_MODEL_REQUESTS_PER_MINUTE=0
# Soft-deleted documents are restorable for this many days, then purged by the
# worker maintenance loop.
DOCUMENT_RETENTION_DAYS=30
# Authorization audit rows older than this are deleted by the worker's hourly
# batched purge. 0 keeps audit rows forever.
AUDIT_RETENTION_DAYS=180
# SSE replay buffers older than this are deleted by the same hourly purge.
# Answers, citations and evidence live on messages, so expiry only stops
# reconnect replay for old requests. 0 keeps replay buffers forever.
STREAM_EVENT_RETENTION_DAYS=7
# Finished ingestion pipeline runs (stage runs, inbox rows, their outbox events)
# and resolved/discarded dead letters older than this are deleted by the same
# hourly purge. Document versions, chunks and evidence packages are kept.
# 0 keeps task history forever.
TASK_HISTORY_RETENTION_DAYS=90
OUTBOX_MAX_ATTEMPTS=10
# Events claimed per outbox tick. Each tick publishes a batch outside the claim
# transaction; the lease prevents another worker from taking the same rows.
OUTBOX_BATCH_SIZE=64
RECONCILE_INTERVAL_SECONDS=60
# Worker pools: ingestion (bulk), interactive (operator retries) and
# maintenance (reconcile/purge) are separate queues with separate weights.
WORKER_CONCURRENCY=4
# Drain window for api and worker shutdown.
SHUTDOWN_TIMEOUT_SECONDS=10
# Pipeline B per-package generation cache. true reuses Wiki/Relation output for
# unchanged EvidencePackages; false restores full regeneration and is the
# rollback switch. Manual wiki/graph rebuild clears the cache either way.
PROJECTION_INCREMENTAL_ENABLED=true

# ----------------------------------------------------------------------------
# LLM provider
# ----------------------------------------------------------------------------
# Placeholder settings for later RAG milestones. Keep real API keys out of
# source control; replace example values before enabling model calls.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_CHAT_MODEL=replace-me
LLM_EMBEDDING_MODEL=replace-me
# Reranker model name. Required by RERANK_SOURCE=remote and ignored by the
# offline sources; it is not a disable switch (use RERANK_SOURCE=none).
LLM_RERANK_MODEL=
# Per-request model timeout in seconds.
LLM_REQUEST_TIMEOUT_SECONDS=60

# ----------------------------------------------------------------------------
# Generation provider (api)
# ----------------------------------------------------------------------------
# The generation adapter follows the same configuration pattern as embedding:
#   CHAT_SOURCE=local   offline extractive adapter: it only cites evidence
#                       sentences that literally contain query terms and returns
#                       no answer when nothing matches. Development and
#                       acceptance only; startup fails when APP_ENV=production.
#   CHAT_SOURCE=remote  OpenAI-compatible /chat/completions endpoint.
CHAT_SOURCE=local
# Endpoint for the remote adapter; falls back to LLM_BASE_URL when empty.
CHAT_BASE_URL=
# Credential for the remote adapter; falls back to LLM_API_KEY when empty.
CHAT_API_KEY=
# Optional provider liveness endpoint used for health-based degradation. Empty
# derives it from the base URL (/models); a reachable 404 still counts as
# healthy. Probe failures downgrade a knowledge base binding to the default.
CHAT_HEALTH_URL=
# Upper bound on generated tokens per answer.
CHAT_MAX_TOKENS=1024
# Per-answer model timeout in seconds; also bounds the online answer request.
CHAT_TIMEOUT_SECONDS=60
# Completed user/assistant turns replayed to generation. Zero disables
# multi-turn context (single-turn behaviour).
CHAT_HISTORY_TURNS=3
# Token budget for replayed history, independent of the evidence context.
CHAT_HISTORY_TOKEN_LIMIT=1200
# Rewrite a follow-up question into a standalone retrieval query before recall.
# Only runs when history exists and CHAT_SOURCE is a real adapter.
CHAT_QUERY_REWRITE_ENABLED=true
# Per-rewrite model timeout in seconds.
CHAT_QUERY_REWRITE_TIMEOUT_SECONDS=8
# Async answers: POST /sessions/:id/messages returns a stream that tails the
# persisted events while a worker generates the answer. Set false to fall back
# to the synchronous in-request path (rollback switch).
ANSWER_ASYNC_ENABLED=true
# How long one HTTP tail waits for a terminal event before giving up. A
# reconnecting client resumes from the last event id regardless.
ANSWER_TAIL_TIMEOUT_SECONDS=180
# Replay polling interval for an open tail, in milliseconds.
ANSWER_ASYNC_POLL_INTERVAL_MS=250
# Worker lease on a claimed answer job. The maintenance sweep fails a job whose
# lease expired, so a crashed worker produces a terminal error instead of a
# stream that never ends.
ANSWER_ASYNC_LEASE_SECONDS=300
# Comma-separated extra chat models this deployment serves, in name or
# name@version form. The default CHAT_MODEL is always registered; these entries
# let a knowledge base select a different one. Ignored by the offline adapter.
CHAT_MODELS=

# ----------------------------------------------------------------------------
# Prompt templates and retrieval parameters (api)
# ----------------------------------------------------------------------------
# Prompt wording is configuration, never code. Every template id listed in
# internal/prompts is required; a missing or duplicated id fails startup.
PROMPT_TEMPLATE_DIR=config/prompt_templates
# Global retrieval parameter defaults (the first tier of the override chain:
# file -> knowledge base (database, audited) -> session). A partial file only
# overrides the keys it states.
RETRIEVAL_CONFIG_FILE=config/config.yaml

# ----------------------------------------------------------------------------
# Embedding provider (worker)
# ----------------------------------------------------------------------------
# The embedding model is configuration, not code: swapping providers or models
# must not require a rebuild. The dimension is part of the index contract --
# changing it requires a new index and a full re-embedding of existing chunks.
#
# EMBEDDING_SOURCE=local   offline deterministic hash vectors, no semantic
#                          meaning. Development and acceptance only. Startup
#                          fails when APP_ENV=production.
# EMBEDDING_SOURCE=remote  OpenAI-compatible /embeddings endpoint. Works with
#                          hosted providers and self-hosted gateways (vLLM,
#                          Ollama compatible routes, one-api style proxies).
EMBEDDING_SOURCE=local
# Model endpoint; falls back to LLM_BASE_URL when empty. Required for remote.
EMBEDDING_BASE_URL=
# Credential; falls back to LLM_API_KEY when empty.
EMBEDDING_API_KEY=
# Optional provider liveness endpoint used for health-based degradation. Empty
# derives it from the base URL (/models); a reachable 404 still counts as
# healthy.
EMBEDDING_HEALTH_URL=
# Vector dimension the index is built for. Must be a positive integer and
# must match what the provider actually returns. Changing it is a managed
# switch: run `make embed-index` to build halfvec(N) CONCURRENTLY, `make
# embed-rebuild` to re-embed existing chunks, then `make embed-verify`. The
# new index gets a versioned name and the old one is dropped only after the
# replacement validates. `make embed-check` prints the current state first.
EMBEDDING_DIMENSION=3
# Texts per provider request. Some gateways cap this lower than a nominal value:
# the Alibaba MaaS compatible-mode embedding endpoint rejects batches above 20
# ("batch size is invalid, it should not be larger than 20"), which fails the
# whole document version at ingestion.
EMBEDDING_BATCH_SIZE=20
# Per-call model timeout in seconds.
EMBEDDING_TIMEOUT_SECONDS=60
# Online index build limits for embedctl create-index. lock_timeout bounds how
# long CREATE INDEX CONCURRENTLY waits for its brief locks; statement_timeout
# bounds the whole build (0 = unlimited, suitable for very large tables).
EMBED_INDEX_LOCK_TIMEOUT_SECONDS=10
EMBED_INDEX_STATEMENT_TIMEOUT_SECONDS=0

# ----------------------------------------------------------------------------
# Rerank provider (api)
# ----------------------------------------------------------------------------
# Rerank is a configurable capability, not a required dependency: rerank only
# runs when the retrieval parameter rerank_enabled is true (config/config.yaml,
# or a knowledge base / session override). Which adapter runs is chosen here.
#
# RERANK_SOURCE=none      pass-through. The default, so turning rerank on is an
#                         explicit decision rather than an accidental model call.
# RERANK_SOURCE=lexical   offline deterministic overlap reranker: scores the
#                         fraction of query terms a chunk contains. No provider.
# RERANK_SOURCE=remote    OpenAI-compatible /rerank endpoint.
RERANK_SOURCE=none
# Model endpoint; falls back to LLM_BASE_URL when empty. Required for remote.
RERANK_BASE_URL=
# Credential; falls back to LLM_API_KEY when empty.
RERANK_API_KEY=
# Optional provider liveness endpoint used for health-based degradation. Empty
# derives it from the base URL (/health); a reachable 404 still counts as
# healthy. Probe failures downgrade a knowledge base binding to the default.
RERANK_HEALTH_URL=
# Per-call model timeout in seconds; falls back to LLM_REQUEST_TIMEOUT_SECONDS.
RERANK_TIMEOUT_SECONDS=60
# Comma-separated extra rerank models this deployment serves, in name or
# name@version form. LLM_RERANK_MODEL is always registered; ignored by the
# offline sources.
RERANK_MODELS=

# ----------------------------------------------------------------------------
# Python document reader
# ----------------------------------------------------------------------------
# Internal gRPC endpoint for digital PDF/DOCX/XLSX/PPTX/HTML/Markdown/TXT parsing.
# Scanned and mixed PDFs return unsupported_scanned_pdf, legacy OLE .xls/.ppt
# return unsupported_legacy_office; image parsing and OCR are deliberately absent.
DOCREADER_GRPC_ADDR=docreader:50051
# Parser implementation version shown read-only in the workbench. Both the API
# and the docreader container read it; deploy them with the same value.
PARSER_VERSION=docreader-m2-v2
# Future ingestion limits: maximum upload size and parser task duration.
DOCREADER_MAX_FILE_MB=100
DOCREADER_TASK_TIMEOUT_SECONDS=120

# ----------------------------------------------------------------------------
# Chunking policy (worker)
# ----------------------------------------------------------------------------
# Chunk granularity is policy, not code. Documents differ in shape (manuals,
# policies, FAQ), so these values are configuration. Changing them does not
# require a rebuild; already-ingested documents keep their chunks until they
# are explicitly reprocessed.
# Target maximum chunk length in runes.
CHUNK_SIZE=900
# Runes shared between consecutive chunks when no natural boundary is found.
# Use 0 to disable overlap.
CHUNK_OVERLAP=120
# Preferred split points, tried before the fixed-size window. Comma-separated.
# Use \n and \t escapes so newlines can be expressed in .env files.
CHUNK_SPLIT_MARKERS=\n\n,\n,。,.,！,!,？,?
# Trailing chunks shorter than this are merged into the previous chunk.
# Use 0 to keep every chunk.
CHUNK_MIN_SIZE=0

# ----------------------------------------------------------------------------
# Restricted document-parser sandbox
# ----------------------------------------------------------------------------
# Keep enabled when document parsing is introduced. These values describe the
# isolated parser workload, not resource limits for the whole Compose stack.
# Read today: PARSER_SANDBOX_ENABLED (startup validation) and the CPU/memory/PID
# limits below (applied by Compose to the docreader container).
PARSER_SANDBOX_ENABLED=true
PARSER_SANDBOX_CPU_LIMIT=2
PARSER_SANDBOX_MEMORY_MB=2048
PARSER_SANDBOX_PIDS_LIMIT=128

# ----------------------------------------------------------------------------
# External data sources (M5)
# ----------------------------------------------------------------------------
# Credentials are sealed with AES-256-GCM before they reach PostgreSQL. Keys
# must be 32 bytes encoded as base64 or hex; the value below is a development
# placeholder. Use CONNECTOR_ENCRYPTION_KEY for a single key, or a comma
# separated kid:key keyring in CONNECTOR_ENCRYPTION_KEYS plus
# CONNECTOR_ENCRYPTION_ACTIVE_KID. To rotate: add the new kid, switch the active
# kid, and keep the old key registered so existing envelopes stay decryptable.
CONNECTOR_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CONNECTOR_ENCRYPTION_KEYS=
CONNECTOR_ENCRYPTION_ACTIVE_KID=
# Allow connectors to reach loopback/private/link-local addresses. Keep false
# in production; enable only to sync from a local fixture or trusted intranet.
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
# Per-request timeout for manifest and file downloads.
CONNECTOR_REQUEST_TIMEOUT_SECONDS=30
# Maximum accepted manifest size (the item list, not the files themselves).
CONNECTOR_MAX_MANIFEST_BYTES=2097152
# Default request spacing when a connector does not set requestsPerSecond.
CONNECTOR_REQUESTS_PER_SECOND=2

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
# Metrics are exported at GET /api/v1/ops/metrics (JSON, tenant owner/admin
# session). Prometheus scrapes the dedicated listener enabled by METRICS_ADDR in
# both the api and worker processes: each serves only its own process counters
# at GET /metrics with no tenant auth, so bind an internal or loopback address
# and never publish it to the public internet. Empty disables the listener.
# Scrape them as separate targets (the observability overlay uses api:9090 and
# worker:9091). Empty OTEL_EXPORTER_OTLP_ENDPOINT keeps spans local (IDs still
# correlate logs) and starts no exporter. Set an OTLP/HTTP endpoint to export
# to a collector. GRAFANA_ADMIN_PASSWORD is only read by
# deploy/docker-compose/observability.compose.yml; replace the default in any
# shared environment.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rag-platform
METRICS_ADDR=
GRAFANA_ADMIN_PASSWORD=
