# CI-only enforce profile. Every credential here is a dummy value for the
# disposable GitHub Actions runner; never use this file in production.
APP_ENV=development
DEV_AUTH_ENABLED=true
TENANT_RLS_MODE=enforce
CHAT_SOURCE=local
EMBEDDING_SOURCE=local

POSTGRES_DB=rag_platform
POSTGRES_USER=rag_platform
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://rag_app:ci-app-pass@postgres:5432/rag_platform?sslmode=disable
MAINTENANCE_DATABASE_URL=postgres://rag_maintenance:ci-maintenance-pass@postgres:5432/rag_platform?sslmode=disable
ADMIN_DATABASE_URL=postgres://rag_platform:change-me-local-only@postgres:5432/rag_platform?sslmode=disable
RAG_APP_DB_PASSWORD=ci-app-pass
RAG_MAINTENANCE_DB_PASSWORD=ci-maintenance-pass

S3_ACCESS_KEY=rag-local
S3_SECRET_KEY=change-me-local-only
CONNECTOR_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
API_PORT=8082
