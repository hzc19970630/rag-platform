# CI-only evaluation profile. Infrastructure credentials are dummy values for
# the disposable GitHub Actions runner. The workflow appends the model provider
# settings from repository secrets/variables before starting the stack.
# Never use this file in production.
APP_ENV=development
CONFIG_PROFILE=dev
DEV_AUTH_ENABLED=true
OIDC_ENABLED=false
TENANT_RLS_MODE=off

CHAT_SOURCE=remote
EMBEDDING_SOURCE=remote
EMBEDDING_DIMENSION=1024
# The projection service reuses this timeout. Remote relation extraction over
# the M7 corpus can exceed the 120s default and fail with context deadline.
DOCREADER_TASK_TIMEOUT_SECONDS=1800

POSTGRES_DB=rag_platform
POSTGRES_USER=rag_platform
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://rag_platform:change-me-local-only@postgres:5432/rag_platform?sslmode=disable
ADMIN_DATABASE_URL=postgres://rag_platform:change-me-local-only@postgres:5432/rag_platform?sslmode=disable

S3_ACCESS_KEY=rag-local
S3_SECRET_KEY=change-me-local-only
CONNECTOR_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
API_PORT=8082
