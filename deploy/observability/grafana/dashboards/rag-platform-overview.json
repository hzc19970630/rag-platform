{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API 5xx ratio",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API P95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_ms_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, state) (queue_depth)",
          "legendFormat": "{{queue}} {{state}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox backlog",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "max(outbox_backlog)", "legendFormat": "unpublished events"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Expired inbox leases",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "max(inbox_expired_leases)", "legendFormat": "expired leases"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Projection lag",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "max(projection_lag_seconds)", "legendFormat": "oldest pending run"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingestion parse failures",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(ingestion_stage_total{result=\"failure\"}[10m]))",
          "legendFormat": "{{stage}} failures/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Model errors",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(model_errors_total[10m]))",
          "legendFormat": "{{model}} errors/10m"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["rag-platform", "slo"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "RAG Platform Overview",
  "uid": "rag-platform-overview",
  "version": 1
}
