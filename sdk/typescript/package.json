{
  "name": "@rag-platform/sdk",
  "version": "0.1.0",
  "description": "Thin TypeScript SDK for the RAG Platform HTTP API",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "codegen": "openapi-typescript ../../api/openapi/openapi.yaml -o src/generated.ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/client.test.ts",
    "example": "tsx examples/search-ask-cite.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "openapi-typescript": "7.13.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}