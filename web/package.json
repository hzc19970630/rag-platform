{
  "name": "rag-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "codegen": "openapi-typescript ../api/openapi/openapi.yaml -o src/api/generated.ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/api/generated.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-virtual": "3.14.26",
    "@vitejs/plugin-react": "6.1.2",
    "antd": "^6.6.8",
    "i18next": "^26.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-router-dom": "^7.18.5",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "vitest": "5.0.3"
  }
}
